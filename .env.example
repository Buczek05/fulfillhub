# Konfiguracja dla docker compose. Skopiuj do .env: cp .env.example .env
NODE_ENV=development

# Baza danych
POSTGRES_USER=fulfillhub
POSTGRES_PASSWORD=fulfillhub
POSTGRES_DB=fulfillhub
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
JWT_SECRET=change-me-dev-secret-at-least-16-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200

# Poczta (Mailpit – podgląd na http://localhost:8025)
MAIL_FROM=FulfillHub <no-reply@fulfillhub.local>
