# Konfiguracja dla uruchomienia backendu lokalnie (npm run dev), poza Dockerem.
# Baza i Mailpit nadal z docker compose: docker compose up -d db mailpit
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://fulfillhub:fulfillhub@localhost:5432/fulfillhub
JWT_SECRET=change-me-dev-secret-at-least-16-chars
JWT_EXPIRES_IN=8h
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=FulfillHub <no-reply@fulfillhub.local>
WAREHOUSE_EMAIL=magazyn@fulfillhub.local
CORS_ORIGIN=http://localhost:4200
