{
  "name": "fulfillhub-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FulfillHub – REST API magazynu fulfillment (ZTPAI)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "knex --knexfile src/db/knexfile.js migrate:latest",
    "migrate:make": "knex --knexfile src/db/knexfile.js migrate:make",
    "migrate:rollback": "knex --knexfile src/db/knexfile.js migrate:rollback",
    "seed": "knex --knexfile src/db/knexfile.js seed:run"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
